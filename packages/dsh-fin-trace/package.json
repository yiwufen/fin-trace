{
  "name": "@lihangcz/dsh-fin-trace",
  "version": "0.1.2",
  "description": "DeepSeek Harness (dsh) plugin embedding the fin-trace agent loop — multi-hop relationship reasoning over a financial knowledge graph, exposed as async tools (start/status/cancel)",
  "type": "module",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yiwufen/fin-trace.git",
    "directory": "packages/dsh-fin-trace"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "openai": "^6.42.0",
    "pino": "^10.3.1",
    "schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@types/node": "^25.9.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "knowledge-graph",
    "financial-analysis",
    "mcp",
    "agent"
  ],
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
