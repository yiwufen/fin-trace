{
  "hooks": {
    "enabled": true,
    "events": {
      "PreToolUse": [
        {
          "matcher": "^Bash$",
          "hooks": [
            {
              "type": "process",
              "command": "python3",
              "args": ["${ZCODE_PROJECT_DIR}/.zcode/hooks/block-local-npm-publish.py"],
              "timeoutMs": 5000,
              "statusMessage": "检查 npm publish 拦截规则"
            },
            {
              "type": "process",
              "command": "python3",
              "args": ["${ZCODE_PROJECT_DIR}/.zcode/hooks/block-git-push-main.py"],
              "timeoutMs": 5000,
              "statusMessage": "检查 git push main 拦截规则"
            },
            {
              "type": "process",
              "command": "python3",
              "args": ["${ZCODE_PROJECT_DIR}/.zcode/hooks/block-git-commit-main.py"],
              "timeoutMs": 5000,
              "statusMessage": "检查 main 分支提交拦截规则"
            }
          ]
        }
      ]
    }
  }
}
